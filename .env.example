# ── Copy this file to .env and fill in your values ──────────────────────────
# docker-compose will automatically read a .env file in the same directory.

# Your Google Gemini API key (required)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT signing secret — use a long random string in production
# Generate one with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string

# Override the backend URL seen by the browser (default: http://localhost:8000)
# VITE_API_URL=http://localhost:8000
